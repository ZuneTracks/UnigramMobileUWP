+bool VideoCaptureWinRTInternal::QuiesceFrameCallbacks(DWORD timeout_ms) {
+  std::shared_ptr<FrameArrivedGate> gate;
+  {
+    std::lock_guard<std::mutex> gate_guard(frame_gate_lock_);
+    gate = frame_gate_;
+  }
+  if (!gate) {
+    return true;
+  }
+
+  std::unique_lock<std::mutex> guard(gate->lock);
+  gate->owner = nullptr;
+  const bool drained = gate->drained.wait_for(
+      guard, std::chrono::milliseconds(timeout_ms),
+      [&gate] { return gate->active == 0; });
+  if (!drained) {
+    RTC_LOG(LS_WARNING) << "StopCapture warning: a frame callback is still "
+                           "running after "
+                        << timeout_ms << " ms";
+  }
+  return drained;
+}
